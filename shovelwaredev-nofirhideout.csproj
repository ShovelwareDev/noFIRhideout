<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>shovelwaredev-nofirhideout</AssemblyName>
    <RootNamespace>Shovelwaredev.NoFirHideout</RootNamespace>
    
    <!-- Point this to your actual SPT server root directory on Linux -->
    <SptServerDir>/media/storage/VScode/SPTMod</SptServerDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.2" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.2" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" />
  </ItemGroup>

  <!-- Automated Deployment Target -->
  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(SptServerDir)' != ''">
    <ItemGroup>
      <ModFiles Include="$(TargetDir)**\*.*" />
      <PackageJson Include="$(MSBuildProjectDirectory)/package.json" Condition="Exists('$(MSBuildProjectDirectory)/package.json')" />
    </ItemGroup>
    
    <!-- Copy compiled binaries -->
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(SptServerDir)/user/mods/$(AssemblyName)/%(RecursiveDir)" />
    
    <!-- Copy package.json automatically if it's in your project folder -->
    <Copy SourceFiles="@(PackageJson)" DestinationFolder="$(SptServerDir)/user/mods/$(AssemblyName)/" />
  </Target>

</Project>